{
  "name": "dsh-web-search-nokey",
  "displayName": "DSH Web Search (No Key)",
  "version": "1.0.0",
  "description": "Keyless web search for DeepSeek Harness. Fixes web_search 401 on Trae/WorkBuddy credits setups — no API key needed.",
  "license": "MIT",
  "author": "a1435473620",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "search-provider",
    "no-api-key",
    "trae",
    "workbuddy",
    "credits"
  ],
  "scripts": {
    "smoke": "node test/smoke.mjs",
    "test:seam": "node test/with-seam.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a1435473620/dsh-web-search-nokey.git"
  },
  "homepage": "https://github.com/a1435473620/dsh-web-search-nokey#readme",
  "bugs": {
    "url": "https://github.com/a1435473620/dsh-web-search-nokey/issues"
  }
}
